# ===== AutoSucro - configuración Apache / SiteGround =====

# Desactivar el listado de directorios (equivale a directoryListing: false)
Options -Indexes

# Servir index.html en la raíz y como índice por defecto
DirectoryIndex index.html

# Forzar HTTPS (recomendado)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# Página de error 404 amigable (usa la home; cámbialo si creas una 404.html)
ErrorDocument 404 /index.html

# ===== Caché del navegador para assets estáticos =====
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg        "access plus 1 month"
  ExpiresByType image/png         "access plus 1 month"
  ExpiresByType image/webp        "access plus 1 month"
  ExpiresByType image/svg+xml     "access plus 1 month"
  ExpiresByType text/css          "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

# ===== Compresión GZIP =====
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
