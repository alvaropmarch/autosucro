# ===== AutoSucro - configuración Apache / SiteGround =====

# Desactivar el listado de directorios (equivale a directoryListing: false)
Options -Indexes

# Servir index.html en la raíz y como índice por defecto
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS (recomendado)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Bloquear acceso a la copia de seguridad de WordPress
  RewriteRule ^_wp_backup(/.*)?$ - [F,L]

  # ===== Redirecciones 301 de URLs antiguas de WordPress =====
  RewriteRule ^contacto/?$           /contacto.html   [R=301,L]
  RewriteRule ^servicios/?$          /servicios.html  [R=301,L]
  RewriteRule ^sobre-nosotros/?$     /nosotros.html   [R=301,L]
  RewriteRule ^auto-sucro/?$         /nosotros.html   [R=301,L]
  RewriteRule ^ver-todos/?$          /vehiculos.html  [R=301,L]

  # Fichas de vehículos antiguas -> catálogo
  RewriteRule ^(vw-transporter|mini-contriman|opel-combo|seat-leon|ford-s-max|ford-ka-5-puertas|fiesta-v-o|seat-ibiza|bmw-serie-1)/?$ /vehiculos.html [R=301,L]

  # Páginas residuales de Elementor -> home
  RewriteRule ^elementor[-a-z0-9]*/?$ / [R=301,L]

  # Sitemaps antiguos de Yoast -> sitemap nuevo
  RewriteRule ^(sitemap_index|page-sitemap|post-sitemap|wp-sitemap)\.xml$ /sitemap.xml [R=301,L]

  # Catch-all: cualquier otra URL antigua de WordPress que no exista -> home
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/(css|js|images|Recursos|admin|\.well-known)/ [NC]
  RewriteCond %{REQUEST_URI} !\.(html|css|js|png|jpe?g|webp|svg|ico|woff2?|ttf|xml|txt|pdf|map)$ [NC]
  RewriteRule ^ / [R=301,L]
</IfModule>

# Página de error 404 amigable (usa la home; cámbialo si creas una 404.html)
ErrorDocument 404 /index.html

# ===== Caché del navegador =====
# mod_headers es respetado por LiteSpeed (mod_expires aquí no lo era).
<IfModule mod_headers.c>
  # HTML: nunca servir de caché sin revalidar (los cambios se ven al instante)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  # CSS/JS: caché corta (además van versionados con ?v= en el HTML)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # Imágenes y fuentes: caché larga (no cambian de contenido)
  <FilesMatch "\.(jpe?g|png|webp|svg|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Fallback si mod_headers no estuviera disponible
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg        "access plus 1 month"
  ExpiresByType image/png         "access plus 1 month"
  ExpiresByType image/webp        "access plus 1 month"
  ExpiresByType image/svg+xml     "access plus 1 month"
  ExpiresByType text/css          "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

# ===== Compresión GZIP =====
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
